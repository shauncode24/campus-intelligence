# Copy to backend/.env and fill in. NEVER commit the real file.
#
# Keeping secrets out of a synced folder (OneDrive/Dropbox/iCloud):
#   put the real file somewhere outside the project, e.g.
#   C:\Users\<you>\secrets\campus-intel.env
#   then set a SYSTEM environment variable (not inside this file):
#   ENV_FILE=C:\Users\<you>\secrets\campus-intel.env
# Both the Node API and the Python service will read that file instead of
# backend/.env, and refuse to start if it cannot be found.

# ---------------- Secrets (required) ----------------
# Google AI Studio key used for Gemini
GOOGLE_API_KEY=

# Firebase Admin service account (Firebase console > Project settings > Service accounts).
# Keep FIREBASE_PRIVATE_KEY on one line with literal \n for line breaks.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# Google Calendar OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/calendar/callback

# ---------------- URLs / environment (required) ----------------
NODE_ENV=development
# Exact origin of the web app. Also the only origin allowed by CORS.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
PYTHON_RAG_URL=http://localhost:8000
PORT=5000

# ---------------- Optional ----------------
# Server-side key that lets "delete document" also remove the PDF from
# Supabase storage. Powerful: never put it in the frontend.
# SUPABASE_SERVICE_ROLE_KEY=

# Extra browser origins allowed by CORS (comma-separated). Default: FRONTEND_URL only.
# CORS_ORIGINS=

# Set to 1 ONLY when a trusted reverse proxy (Render, Nginx, ...) sets
# X-Forwarded-For. Without it all users behind the proxy share one IP bucket.
# TRUST_PROXY=1

# Document download safety (SSRF / resource limits)
# ALLOWED_FILE_HOSTS=your-project-ref.supabase.co
# MAX_PDF_BYTES=52428800
# MAX_PDF_PAGES=500
# DOWNLOAD_TIMEOUT_SECONDS=60

# Answer quality
# MIN_RETRIEVAL_SCORE=0.70

# Rate limits (requests per minute unless stated; 0 disables). Starting points, not tuned.
# IP_RATE_PER_MINUTE=600
# USER_RATE_PER_MINUTE=120
# WRITE_RATE_PER_MINUTE=60
# QUERY_RATE_PER_MINUTE=10
# QUERY_RATE_PER_MINUTE_PER_IP=60
# ADMIN_RATE_PER_MINUTE=120
# CALENDAR_RATE_PER_MINUTE=30
# LLM_CALLS_PER_USER_PER_DAY=100
# LLM_CALLS_GLOBAL_PER_DAY=3000
# MAX_QUESTION_CHARS=2000
