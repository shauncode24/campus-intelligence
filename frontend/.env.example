# Copy to frontend/.env (dev) or frontend/.env.production (build) and fill in.
# VITE_* values are bundled into the public JavaScript: put NOTHING secret here.

# Node API (documents, calendar, chat stream)
VITE_API_BASE_URL=http://localhost:5000

# Python RAG service (chats, history, FAQ)
VITE_PYTHON_RAG_URL=http://localhost:8000
