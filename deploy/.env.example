# Settings for docker compose (NOT secrets; the secrets live in the file SECRETS_ENV_FILE points to).

# The address people will type, without https://  (its DNS record must point at this machine)
SITE_ADDRESS=campus.example.edu

# Your secrets file (the same variables as backend/.env.example), kept OUTSIDE the repository
SECRETS_ENV_FILE=/home/you/secrets/campus-intel.env

# Memory limit for the RAG container (the two embedding models and PDF parsing need a few GB)
RAG_MEMORY_LIMIT=6g
